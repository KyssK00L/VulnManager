# ==============================================================================
# VulnManager - Environment Configuration
# ==============================================================================
# Copy this file to .env and customize the values for your environment
# ⚠️  NEVER commit .env to version control (it contains secrets)
# ==============================================================================

# ==============================================================================
# DATABASE
# ==============================================================================
# PostgreSQL connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
#
# Examples:
#   - Development: postgresql://vulnmanager:vulnmanager_dev_pass@localhost:5432/vulnmanager
#   - Docker:      postgresql://vulnmanager:vulnmanager_dev_pass@db:5432/vulnmanager
#   - Production:  postgresql://user:strong_password@db.example.com:5432/vulnmanager
#
# Note: When using Docker, change 'localhost' to 'db' (service name)
DATABASE_URL=postgresql://vulnmanager:vulnmanager_dev_pass@localhost:5432/vulnmanager

# ==============================================================================
# SECURITY
# ==============================================================================

# Secret key for session signing and encryption
# REQUIRED: Minimum 32 characters
# ⚠️  CRITICAL: Change this in production!
#
# Generate a secure key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Examples:
#   - Dev:  your_secret_key_here_min_32_chars_change_in_production
#   - Prod: xK8mN2pQ7rT9vW3yZ5aB6cD8eF0gH1iJ4kL7mN0pQ3rT6vW9yZ2aB5cD8eF1
SECRET_KEY=your_secret_key_here_min_32_chars_change_in_production

# Session lifetime in hours
# How long users stay logged in before re-authentication is required
#
# Possible values: Any positive integer
# Examples:
#   - 1  = 1 hour (high security)
#   - 8  = 8 hours (work day)
#   - 24 = 1 day (recommended for dev)
#   - 168 = 1 week (convenient but less secure)
#
# Recommended:
#   - Development: 24
#   - Production:  8
SESSION_LIFETIME_HOURS=24

# Default API token lifetime in days
# How long API tokens (for Word macros) remain valid
# Can be overridden when creating individual tokens
#
# Possible values: Any positive integer, or leave empty for no expiration
# Examples:
#   - 30  = 1 month
#   - 90  = 3 months (recommended)
#   - 365 = 1 year
#   - (empty) = Never expires (⚠️  not recommended)
#
# Recommended:
#   - Development: 90
#   - Production:  30-90
TOKEN_DEFAULT_LIFETIME_DAYS=90

# ==============================================================================
# CORS (Cross-Origin Resource Sharing)
# ==============================================================================
# Comma-separated list of allowed origins for API access
# Controls which domains can make requests to your API
#
# Format: http(s)://domain:port,http(s)://domain2:port
#
# Examples:
#   - Dev:  http://localhost:5173,http://localhost:3000
#   - Prod: https://vulnmanager.example.com,https://app.example.com
#
# ⚠️  NEVER use "*" (allows all origins - security risk)
#
# Note:
#   - Port 5173 = Vite dev server (default)
#   - Port 3000 = Alternative React dev server / Next.js
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# Application environment mode
# Affects logging, debugging, and security features
#
# Possible values:
#   - development  : Debug mode ON, verbose logs, HTTP cookies allowed
#   - staging      : Debug mode OFF, moderate logs, HTTPS recommended
#   - production   : Debug mode OFF, minimal logs, HTTPS required
#
# Effects:
#   - development:
#       * SQL queries logged
#       * Detailed error messages
#       * Cookie secure=false (works on HTTP)
#   - production:
#       * SQL queries NOT logged
#       * Generic error messages
#       * Cookie secure=true (requires HTTPS)
#
# Recommended:
#   - Local dev: development
#   - Staging:   staging
#   - Production: production
ENVIRONMENT=development

# ==============================================================================
# RATE LIMITING
# ==============================================================================
# Enable/disable rate limiting for API endpoints
# Protects against brute-force attacks and API abuse
#
# Possible values:
#   - true  : Rate limiting enabled (recommended)
#   - false : Rate limiting disabled (⚠️  only for testing)
RATE_LIMIT_ENABLED=true

# Maximum requests per minute per IP address
# Applied globally unless specific endpoints override it
#
# Possible values: Any positive integer
# Examples:
#   - 30  = Strict (public API)
#   - 60  = Standard (recommended)
#   - 120 = Permissive (internal use)
#
# Note: Some endpoints (like login) have stricter limits
# Recommended:
#   - Development: 60
#   - Production:  30-60
RATE_LIMIT_PER_MINUTE=60

# ==============================================================================
# OPTIONAL: PostgreSQL Container Configuration (for Docker)
# ==============================================================================
# These are used by the PostgreSQL container in docker-compose.yml
# Uncomment and customize if needed
#
# POSTGRES_USER=vulnmanager
# POSTGRES_PASSWORD=vulnmanager_dev_pass
# POSTGRES_DB=vulnmanager

# ==============================================================================
# PRODUCTION CHECKLIST
# ==============================================================================
# Before deploying to production, ensure:
#   ✅ SECRET_KEY is a strong random 64+ character string
#   ✅ DATABASE_URL uses a strong password
#   ✅ ENVIRONMENT=production
#   ✅ CORS_ORIGINS contains only your production domain(s)
#   ✅ SESSION_LIFETIME_HOURS is reasonable (8-12 recommended)
#   ✅ RATE_LIMIT_ENABLED=true
#   ✅ Database connection uses SSL/TLS
#   ✅ Application is behind HTTPS/reverse proxy
#   ✅ .env file has restricted permissions (chmod 600)
# ==============================================================================
